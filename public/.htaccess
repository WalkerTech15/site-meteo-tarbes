# WeatherSphere — Apache config for Hostinger (public_html)

# Disable directory listing (no "Index of /")
Options -Indexes

# Serve index.html for the root
DirectoryIndex index.html

# The frontend requests the extensionless /api/pexels on every deployment
# target (see src/js/core/config.js PEXELS_PROXY_URL) so the same build works
# unmodified on Vercel, where api/pexels.js answers that route natively.
# Apache has no such file, only api/pexels.php, so rewrite internally —
# the browser URL and the query string are both preserved; this is not a
# redirect and the .php extension is never exposed.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^api/pexels$ api/pexels.php [L]
  # Same arrangement for the Google Places proxy (GOOGLE_PLACES_PROXY_URL in
  # src/js/core/config.js) — one browser route, three server implementations.
  RewriteRule ^api/places$ api/places.php [L]
  RewriteRule ^api/mapillary$ api/mapillary.php [L]
</IfModule>

# Do not serve local secret files if they are ever uploaded by mistake.
# The real production secret belongs OUTSIDE public_html (see README
# "Deploying to Hostinger"); these rules are the safety net for the case where
# someone drops a copy in the web root anyway.
<FilesMatch "^\.env">
  Require all denied
</FilesMatch>
<FilesMatch "(^|-)secrets?(-|\.)">
  Require all denied
</FilesMatch>

# The Pexels proxy must never be cached at the edge with its query string
# stripped, and it sets its own Cache-Control per response.
<IfModule mod_headers.c>
  <FilesMatch "^(pexels|places|mapillary)\.php$">
    Header always set X-Content-Type-Options "nosniff"
    Header always unset Access-Control-Allow-Origin
  </FilesMatch>
</IfModule>

# Baseline security headers
<IfModule mod_headers.c>
  # Never let the browser guess a MIME type different from the declared one
  Header set X-Content-Type-Options "nosniff"
  # Don't leak the full URL to third-party APIs (Open-Meteo, MapTiler)
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  # The site is never meant to be framed by another page
  Header set X-Frame-Options "SAMEORIGIN"
  # No camera/microphone/payment access is used anywhere; geolocation is
  Header set Permissions-Policy "geolocation=(self), camera=(), microphone=(), payment=()"
</IfModule>

# Long-cache static assets. HTML is always revalidated so a new deploy is picked
# up immediately; the ?v= query string on the CSS/JS tags in index.html is what
# busts those caches (without it, a fix stays invisible for the full 7 days).
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/svg+xml "access plus 30 days"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# The site is a single index.html with in-page (hash) navigation.
# No SPA rewrite rules are required — every route is client-side via "#".
